{
  "name": "controle-gastos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 5100",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "ANALYZE=true pnpm build",
    "check:frontend-budget": "node scripts/check-frontend-budget.mjs",
    "prod:check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:frontend-budget",
    "prod:migrate": "prisma migrate deploy",
    "prod:verify": "curl --fail --silent --show-error https://controle-gastos-pessoal.vercel.app/api/health"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "jsonwebtoken": "^9.0.2",
    "next": "16.3.3",
    "pg": "^8.18.0",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "resend": "^6.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.3.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^25.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.3.3",
    "knip": "^5.85.0",
    "prisma": "^7.4.1",
    "tailwindcss": "^4",
    "ts-prune": "^10.3.6",
    "typescript": "^5.8.3",
    "vitest": "4.1.11"
  }
}
