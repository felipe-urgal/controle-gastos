{
  "name": "controle-gastos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 5100",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:deps": "pnpm --dir tests/e2e --ignore-workspace install --frozen-lockfile",
    "test:e2e": "pnpm --dir tests/e2e --ignore-workspace exec playwright test --config=../../playwright.config.mjs",
    "test:e2e:install": "pnpm test:e2e:deps && pnpm --dir tests/e2e --ignore-workspace exec playwright install chromium",
    "analyze": "ANALYZE=true pnpm build",
    "check:frontend-budget": "node scripts/check-frontend-budget.mjs",
    "prod:check": "node scripts/prod-check.mjs",
    "prod:migrate": "prisma migrate deploy",
    "prod:verify": "curl --fail --silent --show-error https://controle-gastos-pessoal.vercel.app/api/health"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.1",
    "jsonwebtoken": "^9.0.2",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}
