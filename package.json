{
  "name": "controle-gastos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 5100",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && node scripts/clean-next-types.mjs && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "prisma generate && node scripts/analyze-bundle.mjs",
    "security:rotate-totp-key": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rotate-totp-encryption-key.mjs",
    "check:frontend-budget": "node scripts/check-frontend-budget.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prod:check": "node scripts/prod-check.mjs",
    "prod:migrate": "pnpm db:migrate",
    "prod:smoke": "node scripts/prod-smoke.mjs",
    "prod:verify": "pnpm prod:smoke",
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "preanalyze": "node scripts/prepare-ocr-assets.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@mlc-ai/web-llm": "0.2.86",
    "@modelcontextprotocol/server": "2.3.1",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.3.0",
    "jsonwebtoken": "^9.0.2",
    "next": "16.4.2",
    "otplib": "13.5.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.30",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "resend": "^6.33.0",
    "zod": "^4.6.7",
    "@tesseract.js-data/por": "1.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@modelcontextprotocol/client": "2.3.1",
    "@next/bundle-analyzer": "^16.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^25.9.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  }
}
