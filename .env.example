DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters-32-bytes-total
TOTP_ENCRYPTION_KEY_VERSION=1
# Durante rotação controlada: version:64hex separado por vírgulas. Fora da rotação, deixe vazio.
TOTP_ENCRYPTION_PREVIOUS_KEYS=
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=no-reply@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:5100

# Smoke pós-deploy: opcionais. Use somente conta dedicada sem MFA.
# PROD_SMOKE_BASE_URL=https://controle-gastos-pessoal.vercel.app
# PROD_SMOKE_EMAIL=
# PROD_SMOKE_PASSWORD=
