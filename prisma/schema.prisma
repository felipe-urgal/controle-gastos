generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(100)
  email               String    @unique @db.VarChar(120)
  emailVerifiedAt     DateTime? @default(now()) @map("email_verified_at")
  password            String    @db.VarChar(255)
  lastLogin           DateTime? @map("last_login")
  isActive            Boolean   @default(true)
  authVersion         Int       @default(0) @map("auth_version")
  showValues                  Boolean                  @default(true)
  periodicSummaryEnabled      Boolean                  @default(false) @map("periodic_summary_enabled")
  periodicSummaryFrequency    PeriodicSummaryFrequency @default(WEEKLY) @map("periodic_summary_frequency")
  periodicSummaryLastProcessedAt DateTime?              @map("periodic_summary_last_processed_at")
  totpEnabled                 Boolean                  @default(false) @map("totp_enabled")
  totpSecretEncrypted String?   @map("totp_secret_encrypted") @db.Text
  totpActivatedAt     DateTime? @map("totp_activated_at")
  totpLastUsedStep    BigInt?   @map("totp_last_used_step")

  accounts              Account[]
  categories            Category[]
  categoryMonthlyLimits CategoryMonthlyLimit[]
  importRules           TransactionImportRule[]
  mfaLoginChallenges    MfaLoginChallenge[]
  reconciliationEvents  AccountReconciliationEvent[]
  resetTokens           PasswordResetToken[]
  totpRecoveryCodes     TotpRecoveryCode[]
  transactions               Transaction[]
  merchants                  Merchant[]
  merchantAliases             MerchantAlias[]
  transactionCreateOperations TransactionCreateOperation[]
  transactionAllocations      TransactionAllocation[]
  tags                   Tag[]
  transactionTags        TransactionTag[]
  transactionTemplates   TransactionTemplate[]
  transactionSeries     TransactionSeries[]
  subscriptionReviews   SubscriptionReview[]
  transfers             Transfer[]
  creditCardPayments     CreditCardPayment[]
  financialGoals              FinancialGoal[]
  financialGoalEntries        FinancialGoalEntry[]
  periodicFinancialSummaries  PeriodicFinancialSummary[]
  exchangeRates                ExchangeRate[]
  debts                   Debt[]
  debtAdjustments         DebtAdjustment[]
  investmentAssets        InvestmentAsset[]
  investmentOperations    InvestmentOperation[]
  investmentIncomes       InvestmentIncome[]
  investmentFiscalEvents          InvestmentFiscalEvent[]
  investmentFiscalCostAdjustments InvestmentFiscalCostAdjustment[]
  mcpAccessTokens                  McpAccessToken[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
  @@index([lastLogin])
  @@index([createdAt, isActive])
}


model McpAccessToken {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(80)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  tokenPrefix String   @map("token_prefix") @db.VarChar(20)
  scope      String    @default("finance:read") @db.VarChar(40)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("mcp_access_tokens")
}

model Account {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(100)
  type         AccountType
  currency     String      @default("BRL") @db.Char(3)
  isActive     Boolean     @default(true)
  color        String?     @db.Char(7)
  icon         String?     @db.VarChar(30)
  description          String? @db.VarChar(500)
  creditLimit          Int?    @map("credit_limit")
  statementClosingDay  Int?    @map("statement_closing_day")
  statementDueDay      Int?    @map("statement_due_day")

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  importRules          TransactionImportRule[]
  reconciliationEvents AccountReconciliationEvent[]
  transactions         Transaction[]
  transactionTemplates  TransactionTemplate[]
  cardPayments         CreditCardPayment[] @relation("CreditCardPaymentCard")
  sourceCardPayments   CreditCardPayment[] @relation("CreditCardPaymentSource")
  financialGoals       FinancialGoal[]
  investmentOperations InvestmentOperation[]
  investmentIncomes    InvestmentIncome[]
  investmentFiscalEvents InvestmentFiscalEvent[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("accounts")
  @@unique([name, userId])
 
  @@index([userId])
  @@index([userId, type])
  @@index([userId, isActive])
  @@index([userId, currency, isActive])
}

enum AccountType {
  CREDIT_DEBIT
  INVESTMENT
  CREDIT_CARD
}

enum InvestmentAssetType {
  STOCK
  FII
  ETF
  FIXED_INCOME
  CRYPTO
  FUND
  OTHER
}

enum InvestmentOperationType {
  BUY
  SELL
}

enum InvestmentFiscalEventType {
  BUY
  SELL
  CUSTODY_TRANSFER_IN
  CUSTODY_TRANSFER_OUT
  BONUS
  SPLIT
  REVERSE_SPLIT
  OTHER
}

enum InvestmentFiscalClassificationSource {
  SYSTEM
  USER
}

enum InvestmentIncomeType {
  INCOME
  DIVIDEND
  INTEREST
  OTHER
}

model InvestmentAsset {
  id       String              @id @default(uuid())
  symbol   String              @db.VarChar(24)
  name     String?             @db.VarChar(120)
  type     InvestmentAssetType
  currency String              @default("BRL") @db.Char(3)
  market   String?             @db.VarChar(40)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  operations   InvestmentOperation[]
  incomes      InvestmentIncome[]
  fiscalEvents          InvestmentFiscalEvent[]
  fiscalCostAdjustments InvestmentFiscalCostAdjustment[]
  quote                 AssetQuote?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, symbol, currency])
  @@index([userId, type, currency])
  @@map("investment_assets")
}

model AssetQuote {
  id          String   @id @default(uuid())
  priceCents  Int      @map("price_cents")
  currency    String   @db.Char(3)
  referenceAt DateTime @map("reference_at")
  source      String   @default("BRAPI") @db.VarChar(20)
  fetchedAt   DateTime @map("fetched_at")

  assetId String          @unique @map("asset_id")
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([source, fetchedAt])
  @@map("asset_quotes")
}

model EconomicIndicatorObservation {
  id            String   @id @default(uuid())
  key           String   @db.VarChar(32)
  seriesCode    Int      @map("series_code")
  valueMicros   Int      @map("value_micros")
  unit          String   @db.VarChar(32)
  period        String   @db.VarChar(32)
  referenceDate DateTime @map("reference_date") @db.Date
  source        String   @default("BCB_SGS") @db.VarChar(20)
  fetchedAt     DateTime @map("fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, referenceDate])
  @@index([key, fetchedAt])
  @@map("economic_indicator_observations")
}

model InvestmentOperation {
  id             String                  @id @default(uuid())
  type           InvestmentOperationType
  quantityUnits  BigInt                  @map("quantity_units")
  unitPriceCents Int                     @map("unit_price_cents")
  feesCents      Int                     @default(0) @map("fees_cents")
  year           Int
  month          Int
  day            Int
  note           String?                 @db.VarChar(500)
  importSource      TransactionImportSource? @map("import_source")
  importFingerprint String?                  @map("import_fingerprint") @db.Char(64)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  fiscalEvent InvestmentFiscalEvent?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month, day])
  @@index([userId, accountId, year, month, day])
  @@index([userId, assetId, year, month, day])
  @@unique([userId, importFingerprint])
  @@map("investment_operations")
}

model InvestmentFiscalEvent {
  id                   String                              @id @default(uuid())
  type                 InvestmentFiscalEventType
  originalType         InvestmentFiscalEventType          @map("original_type")
  classificationSource InvestmentFiscalClassificationSource @default(SYSTEM) @map("classification_source")
  quantityUnits        BigInt                              @map("quantity_units")
  year                 Int
  month                Int
  day                  Int
  sourceInstitution    String?                            @map("source_institution") @db.VarChar(120)
  destinationInstitution String?                          @map("destination_institution") @db.VarChar(120)
  reclassificationNote String?                            @map("reclassification_note") @db.VarChar(500)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  operationId String?              @unique @map("operation_id")
  operation   InvestmentOperation? @relation(fields: [operationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month, day])
  @@index([userId, accountId, year, month, day])
  @@index([userId, assetId, year, month, day])
  @@map("investment_fiscal_events")
}

model InvestmentFiscalCostAdjustment {
  id             String @id @default(uuid())
  quantityUnits  BigInt @map("quantity_units")
  costBasisCents Int    @map("cost_basis_cents")
  year           Int
  month          Int
  day            Int
  reason         String @db.VarChar(500)
  sourceInstitution String? @map("source_institution") @db.VarChar(120)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month, day])
  @@index([userId, assetId, year, month, day])
  @@map("investment_fiscal_cost_adjustments")
}

model InvestmentIncome {
  id             String               @id @default(uuid())
  type           InvestmentIncomeType @default(INCOME)
  quantityUnits  BigInt               @map("quantity_units")
  unitValueCents Int                  @map("unit_value_cents")
  netAmountCents Int                  @map("net_amount_cents")
  year           Int
  month          Int
  day            Int
  note           String?              @db.VarChar(500)
  importSource      TransactionImportSource? @map("import_source")
  importFingerprint String?                  @map("import_fingerprint") @db.Char(64)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month, day])
  @@index([userId, accountId, year, month, day])
  @@index([userId, assetId, year, month, day])
  @@unique([userId, importFingerprint])
  @@map("investment_incomes")
}

enum PeriodicSummaryFrequency {
  WEEKLY
}

model Category {
  id          String      @id @default(uuid())
  name        String      @db.VarChar(50)
  color       String      @default("#3B82F6") @db.Char(7)
  icon        String      @default("tag") @db.VarChar(30)
  isActive    Boolean     @default(true)
  type        CategoryType @default(EXPENSE)
  description String?     @db.VarChar(200)
  position    Int         @default(0)
  
  importRules TransactionImportRule[]
  transactions Transaction[]
  transactionAllocations TransactionAllocation[]
  transactionTemplates TransactionTemplate[]
  monthlyLimits CategoryMonthlyLimit[]
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  @@unique([name, userId, type])
  @@map("categories")

  @@index([userId])
  @@index([userId, name])
  @@index([userId, position])
  @@index([userId, type, isActive])
}

enum CategoryType {
  INCOME
  EXPENSE
}

model CategoryMonthlyLimit {
  id         String   @id @default(uuid())
  amount     Int
  year       Int
  month      Int
  currency   String   @default("BRL") @db.Char(3)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, year, month, currency])
  @@index([userId, year, month, currency])
  @@index([categoryId, year, month, currency])
  @@map("category_monthly_limits")
}

model TransactionImportRule {
  id                    String                        @id @default(uuid())
  name                  String                        @db.VarChar(100)
  isActive              Boolean                       @default(true)
  priority              Int                           @default(0)
  transactionType       CategoryType
  descriptionOperator   ImportRuleDescriptionOperator
  descriptionPattern    String                        @db.VarChar(255)
  minAmountCents        Int?
  maxAmountCents        Int?
  normalizedDescription String?                       @db.VarChar(255)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive, priority, id])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@map("transaction_import_rules")
}

enum ImportRuleDescriptionOperator {
  EQUALS
  STARTS_WITH
  CONTAINS
}

model Transaction {
  id                   String               @id @default(uuid())
  amount               Int                  @default(0)
  month                Int
  year                 Int
  day                  Int
  type                 TransactionType
  kind                 TransactionKind      @default(NORMAL)
  description          String               @db.VarChar(255)
  status               TransactionStatus
  reconciliationStatus ReconciliationStatus @default(UNCLEARED) @map("reconciliation_status")
  reconciledAt         DateTime?            @map("reconciled_at")

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  merchantId String?   @map("merchant_id")
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  transferId   String?       @map("transfer_id")
  transferRole TransferRole? @map("transfer_role")
  transfer     Transfer?     @relation(fields: [transferId, userId], references: [id, userId], onDelete: Cascade)

  creditCardPayment CreditCardPayment?
  createOperation   TransactionCreateOperation?
  allocations       TransactionAllocation[]
  tagLinks          TransactionTag[]

  seriesId    String?
  series      TransactionSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesIndex Int?               @map("series_index")

  importSource      TransactionImportSource? @map("import_source")
  importFingerprint String?                  @map("import_fingerprint") @db.Char(64)
  importExternalId  String?                  @map("import_external_id") @db.VarChar(191)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("transactions")

  @@index([userId, year, month])
  @@index([userId, year, month, day])
  @@index([accountId, year, month])
  @@index([userId, categoryId, year, month])
  @@index([userId, merchantId, year, month])
  @@index([accountId, type, year, month])
  @@index([userId, status, accountId, type])
  @@index([seriesId])
  @@index([userId, importSource])
  @@index([transferId])
  @@index([userId, kind, year, month])
  @@index([userId, accountId, reconciliationStatus, year, month])
  @@unique([seriesId, seriesIndex])
  @@unique([userId, importFingerprint])
  @@unique([transferId, transferRole])
}

model TransactionCreateOperation {
  id                 String  @id @default(uuid())
  idempotencyKeyHash String  @map("idempotency_key_hash") @db.Char(64)
  requestHash        String  @map("request_hash") @db.Char(64)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String?      @unique @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, idempotencyKeyHash])
  @@index([userId, createdAt])
  @@map("transaction_create_operations")
}

model TransactionTemplate {
  id          String            @id @default(uuid())
  name        String            @db.VarChar(80)
  type        TransactionType
  description String            @default("") @db.VarChar(255)
  amount      Int?
  status      TransactionStatus @default(COMPLETED)
  isFavorite  Boolean           @default(false) @map("is_favorite")
  position    Int               @default(0)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isFavorite, position])
  @@index([userId, type])
  @@map("transaction_templates")
}

model Merchant {
  id       String  @id @default(uuid())
  name     String  @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  aliases      MerchantAlias[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, isActive, name])
  @@map("merchants")
}

model MerchantAlias {
  id                String                        @id @default(uuid())
  pattern           String                        @db.VarChar(120)
  normalizedPattern String                        @map("normalized_pattern") @db.VarChar(120)
  operator          ImportRuleDescriptionOperator
  priority          Int                           @default(0)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, merchantId, operator, normalizedPattern], map: "merchant_aliases_user_merchant_operator_pattern_key")
  @@index([userId, priority, id], map: "merchant_aliases_user_priority_id_idx")
  @@index([merchantId, priority, id], map: "merchant_aliases_merchant_priority_id_idx")
  @@map("merchant_aliases")
}

model Tag {
  id   String @id @default(uuid())
  name String @db.VarChar(40)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionLinks TransactionTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, name])
  @@map("tags")
}

model TransactionTag {
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([transactionId, tagId])
  @@index([userId, tagId, transactionId])
  @@index([tagId, transactionId])
  @@map("transaction_tags")
}

model TransactionAllocation {
  id     String @id @default(uuid())
  amount Int

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([transactionId, categoryId])
  @@index([userId, categoryId])
  @@index([transactionId])
  @@map("transaction_allocations")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionKind {
  NORMAL
  TRANSFER
  CARD_PAYMENT
}

enum TransferRole {
  SOURCE
  DESTINATION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReconciliationStatus {
  UNCLEARED
  CLEARED
  RECONCILED
}

model AccountReconciliationEvent {
  id                  String                    @id @default(uuid())
  action              ReconciliationAuditAction
  batchReconciledAt   DateTime                  @map("batch_reconciled_at")
  transactionCount    Int                       @map("transaction_count")
  cutoffYear          Int?                      @map("cutoff_year")
  cutoffMonth         Int?                      @map("cutoff_month")
  cutoffDay           Int?                      @map("cutoff_day")
  statementBalance    Int?                      @map("statement_balance")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([accountId, batchReconciledAt, action])
  @@index([userId, accountId, createdAt])
  @@map("account_reconciliation_events")
}

enum ReconciliationAuditAction {
  CONFIRMED
  UNDONE
}

enum TransactionImportSource {
  CSV
  OFX
  QIF
  XLSX
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionReviewStatus {
  CONFIRMED
  REJECTED
  IGNORED
}

model SubscriptionReview {
  id        String                   @id @default(uuid())
  patternId String                   @map("pattern_id") @db.Char(24)
  status    SubscriptionReviewStatus

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, patternId])
  @@index([userId, status])
  @@map("subscription_reviews")
}

enum TransactionSeriesType {
  RECURRING
  INSTALLMENT
}

model TransactionSeries {
  id              String                @id @default(uuid())
  type            TransactionSeriesType @default(RECURRING)
  frequency       RecurrenceFrequency   @default(MONTHLY)
  interval        Int                   @default(1)
  description     String?               @db.VarChar(100)
  anchorDay       Int
  startYear       Int
  startMonth      Int
  startDay        Int
  endYear         Int
  endMonth        Int
  endDay          Int
  occurrenceCount Int

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("transaction_series")
  @@index([userId])
  @@index([userId, type])
}

model Transfer {
  id                 String        @id @default(uuid())
  idempotencyKeyHash String?       @map("idempotency_key_hash") @db.Char(64)
  requestHash        String?       @map("request_hash") @db.Char(64)
  deletedAt          DateTime?     @map("deleted_at")
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, userId])
  @@unique([userId, idempotencyKeyHash])
  @@index([userId])
  @@index([userId, deletedAt])
  @@map("transfers")
}

model CreditCardPayment {
  id                 String @id @default(uuid())
  amount             Int
  closingYear        Int    @map("closing_year")
  closingMonth       Int    @map("closing_month")
  closingDay         Int    @map("closing_day")
  idempotencyKeyHash String @map("idempotency_key_hash") @db.Char(64)
  requestHash        String @map("request_hash") @db.Char(64)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardAccountId String  @map("card_account_id")
  cardAccount   Account @relation("CreditCardPaymentCard", fields: [cardAccountId], references: [id], onDelete: Cascade)

  sourceAccountId String  @map("source_account_id")
  sourceAccount   Account @relation("CreditCardPaymentSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)

  sourceTransactionId String      @unique @map("source_transaction_id")
  sourceTransaction   Transaction @relation(fields: [sourceTransactionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, idempotencyKeyHash])
  @@unique([userId, cardAccountId, closingYear, closingMonth, closingDay])
  @@index([userId, cardAccountId, createdAt])
  @@index([userId, sourceAccountId])
  @@map("credit_card_payments")
}

enum FinancialGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum FinancialGoalEntryType {
  CONTRIBUTION
  WITHDRAWAL
}

model FinancialGoal {
  id          String              @id @default(uuid())
  name        String              @db.VarChar(100)
  targetAmount Int                @map("target_amount")
  currency    String              @default("BRL") @db.Char(3)
  targetYear  Int?                @map("target_year")
  targetMonth Int?                @map("target_month")
  targetDay   Int?                @map("target_day")
  status      FinancialGoalStatus @default(ACTIVE)
  description String?             @db.VarChar(500)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  entries FinancialGoalEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status, createdAt])
  @@index([userId, currency, status])
  @@index([userId, accountId])
  @@map("financial_goals")
}

model FinancialGoalEntry {
  id          String                 @id @default(uuid())
  type        FinancialGoalEntryType
  amount      Int
  description String?                @db.VarChar(255)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId String @map("goal_id")
  goal   FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, goalId, createdAt])
  @@map("financial_goal_entries")
}

model ExchangeRate {
  id             String @id @default(uuid())
  fromCurrency   String @map("from_currency") @db.Char(3)
  toCurrency     String @map("to_currency") @db.Char(3)
  numerator      Int
  denominator    Int
  source         ExchangeRateSource @default(MANUAL)
  referenceYear  Int @map("reference_year")
  referenceMonth Int @map("reference_month")
  referenceDay   Int @map("reference_day")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, fromCurrency, toCurrency, source, referenceYear, referenceMonth, referenceDay])
  @@index([userId, fromCurrency, toCurrency, referenceYear, referenceMonth, referenceDay])
  @@map("exchange_rates")
}

enum ExchangeRateSource {
  MANUAL
  BCB_PTAX
}

model TotpRecoveryCode {
  id       String    @id @default(uuid())
  codeHash String    @map("code_hash") @db.Char(64)
  usedAt   DateTime? @map("used_at")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("totp_recovery_codes")
}

model MfaLoginChallenge {
  id         String    @id @default(uuid())
  jtiHash    String    @unique @map("jti_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("mfa_login_challenges")
}

model PasswordResetToken {
  id    String @id @default(uuid())
  token String @unique @db.Char(64)
  
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at") @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("password_reset_tokens")

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  id           String    @id @default(uuid())
  key          String    @db.Char(64)
  action       String    @db.VarChar(32)
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now()) @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([key, action])
  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("auth_rate_limits")
}


model Debt {
  id                    String     @id @default(uuid())
  name                  String     @db.VarChar(100)
  currency              String     @default("BRL") @db.Char(3)
  balance               Int
  installmentAmount     Int?       @map("installment_amount")
  dueYear               Int?       @map("due_year")
  dueMonth              Int?       @map("due_month")
  dueDay                Int?       @map("due_day")
  remainingInstallments Int?       @map("remaining_installments")
  institution           String?    @db.VarChar(120)
  description           String?    @db.VarChar(500)
  status                DebtStatus @default(ACTIVE)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  adjustments DebtAdjustment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, currency, status])
  @@map("debts")
}

model DebtAdjustment {
  id              String @id @default(uuid())
  previousBalance Int    @map("previous_balance")
  newBalance      Int    @map("new_balance")
  delta           Int
  description     String? @db.VarChar(255)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  debtId String @map("debt_id")
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, debtId, createdAt])
  @@index([debtId, createdAt])
  @@map("debt_adjustments")
}

enum DebtStatus {
  ACTIVE
  PAID
  ARCHIVED
}


model PeriodicFinancialSummary {
  id        String                   @id @default(uuid())
  frequency PeriodicSummaryFrequency @default(WEEKLY)
  currency  String                   @db.Char(3)

  periodStartYear  Int @map("period_start_year")
  periodStartMonth Int @map("period_start_month")
  periodStartDay   Int @map("period_start_day")
  periodEndYear    Int @map("period_end_year")
  periodEndMonth   Int @map("period_end_month")
  periodEndDay     Int @map("period_end_day")

  content     Json
  generatedAt DateTime @default(now()) @map("generated_at")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, frequency, currency, periodStartYear, periodStartMonth, periodStartDay], map: "periodic_financial_summaries_unique_period")
  @@index([userId, currency, generatedAt])
  @@map("periodic_financial_summaries")
}
