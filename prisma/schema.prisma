generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(100)
  email               String    @unique @db.VarChar(120)
  emailVerifiedAt     DateTime? @default(now()) @map("email_verified_at")
  password            String    @db.VarChar(255)
  lastLogin           DateTime? @map("last_login")
  isActive            Boolean   @default(true)
  authVersion         Int       @default(0) @map("auth_version")
  showValues                  Boolean                  @default(true)
  periodicSummaryEnabled      Boolean                  @default(false) @map("periodic_summary_enabled")
  periodicSummaryFrequency    PeriodicSummaryFrequency @default(WEEKLY) @map("periodic_summary_frequency")
  periodicSummaryLastProcessedAt DateTime?              @map("periodic_summary_last_processed_at")
  totpEnabled                 Boolean                  @default(false) @map("totp_enabled")
  totpSecretEncrypted String?   @map("totp_secret_encrypted") @db.Text
  totpActivatedAt     DateTime? @map("totp_activated_at")
  totpLastUsedStep    BigInt?   @map("totp_last_used_step")

  accounts              Account[]
  categories            Category[]
  categoryMonthlyLimits CategoryMonthlyLimit[]
  importRules           TransactionImportRule[]
  mfaLoginChallenges    MfaLoginChallenge[]
  reconciliationEvents  AccountReconciliationEvent[]
  resetTokens           PasswordResetToken[]
  totpRecoveryCodes     TotpRecoveryCode[]
  transactions               Transaction[]
  merchants                  Merchant[]
  merchantAliases             MerchantAlias[]
  merchantAliasEvents         MerchantAliasEvent[]
  transactionCreateOperations TransactionCreateOperation[]
  transactionAllocations      TransactionAllocation[]
  tags                   Tag[]
  transactionTags        TransactionTag[]
  transactionTemplates   TransactionTemplate[]
  transactionSeries          TransactionSeries[]
  subscriptionReviews        SubscriptionReview[]
  recurrencePatternReviews   RecurrencePatternReview[]
  transfers             Transfer[]
  creditCardPayments     CreditCardPayment[]
  financialGoals              FinancialGoal[]
  financialGoalEntries        FinancialGoalEntry[]
  periodicFinancialSummaries  PeriodicFinancialSummary[]
  exchangeRates                ExchangeRate[]
  debts                   Debt[]
  debtAdjustments         DebtAdjustment[]
  investmentAssets        InvestmentAsset[]
  investmentOperations    InvestmentOperation[]
  investmentIncomes       InvestmentIncome[]
  investmentFiscalEvents          InvestmentFiscalEvent[]
  investmentFiscalCostAdjustments InvestmentFiscalCostAdjustment[]
  investmentMutationRequests      InvestmentMutationRequest[]
  investmentBrokerageTaxReviews   InvestmentBrokerageTaxReview[]
  investmentTaxLossAdjustments     InvestmentTaxLossAdjustment[]
  investmentTaxWithholdings         InvestmentTaxWithholding[]
  investmentTaxPayments             InvestmentTaxPayment[]
  investmentForeignTaxesPaid         InvestmentForeignTaxPaid[]
  investmentFiscalPendingResolutions InvestmentFiscalPendingResolution[]
  mcpAccessTokens                    McpAccessToken[]
  payrollDocuments                   PayrollDocument[]
  payrollAdvanceLinks                PayrollAdvanceLink[]
  payrollTransactionLinks            PayrollTransactionLink[]
  annualEmploymentIncomeStatements   AnnualEmploymentIncomeStatement[]
  annualFinancialTaxStatements       AnnualFinancialTaxStatement[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
  @@index([lastLogin])
  @@index([createdAt, isActive])
}


model McpAccessToken {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(80)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  tokenPrefix String   @map("token_prefix") @db.VarChar(20)
  scope      String    @default("finance:read") @db.VarChar(40)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("mcp_access_tokens")
}

model Account {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(100)
  type         AccountType
  currency     String      @default("BRL") @db.Char(3)
  isActive     Boolean     @default(true)
  color        String?     @db.Char(7)
  icon         String?     @db.VarChar(30)
  description          String? @db.VarChar(500)
  creditLimit          Int?    @map("credit_limit")
  statementClosingDay  Int?    @map("statement_closing_day")
  statementDueDay      Int?    @map("statement_due_day")

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  importRules          TransactionImportRule[]
  reconciliationEvents AccountReconciliationEvent[]
  transactions         Transaction[]
  transactionTemplates  TransactionTemplate[]
  cardPayments         CreditCardPayment[] @relation("CreditCardPaymentCard")
  sourceCardPayments   CreditCardPayment[] @relation("CreditCardPaymentSource")
  financialGoals       FinancialGoal[]
  investmentOperations InvestmentOperation[]
  investmentIncomes    InvestmentIncome[]
  investmentFiscalEvents InvestmentFiscalEvent[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("accounts")
  @@unique([name, userId])
 
  @@index([userId])
  @@index([userId, type])
  @@index([userId, isActive])
  @@index([userId, currency, isActive])
}

enum AccountType {
  CREDIT_DEBIT
  INVESTMENT
  CREDIT_CARD
}

enum InvestmentAssetType {
  STOCK
  FII
  ETF
  FIXED_INCOME
  CRYPTO
  FUND
  OTHER
}

enum InvestmentTaxLocation {
  BRAZIL
  ABROAD
}

enum InvestmentOperationType {
  BUY
  SELL
}

enum InvestmentFiscalEventType {
  BUY
  SELL
  CUSTODY_TRANSFER_IN
  CUSTODY_TRANSFER_OUT
  BONUS
  SPLIT
  REVERSE_SPLIT
  OTHER
}

enum InvestmentFiscalClassificationSource {
  SYSTEM
  USER
}

enum InvestmentIncomeType {
  INCOME
  DIVIDEND
  INTEREST
  OTHER
}

enum InvestmentTaxRecordSource {
  MANUAL
  IMPORT
}

enum ForeignTaxEligibilityBasis {
  TREATY
  RECIPROCITY
}

model InvestmentAsset {
  id       String              @id @default(uuid())
  symbol   String              @db.VarChar(24)
  name     String?             @db.VarChar(120)
  type        InvestmentAssetType
  currency    String                @default("BRL") @db.Char(3)
  market      String?               @db.VarChar(40)
  taxLocation InvestmentTaxLocation @default(BRAZIL) @map("tax_location")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  operations   InvestmentOperation[]
  incomes      InvestmentIncome[]
  fiscalEvents          InvestmentFiscalEvent[]
  fiscalCostAdjustments InvestmentFiscalCostAdjustment[]
  taxWithholdings       InvestmentTaxWithholding[]
  foreignTaxesPaid      InvestmentForeignTaxPaid[]
  quote                 AssetQuote?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, symbol, currency])
  @@index([userId, type, currency])
  @@index([userId, taxLocation])
  @@map("investment_assets")
}

model AssetQuote {
  id          String   @id @default(uuid())
  priceCents  Int      @map("price_cents")
  currency    String   @db.Char(3)
  referenceAt DateTime @map("reference_at")
  source      String   @default("BRAPI") @db.VarChar(20)
  fetchedAt   DateTime @map("fetched_at")

  assetId String          @unique @map("asset_id")
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([source, fetchedAt])
  @@map("asset_quotes")
}

model EconomicIndicatorObservation {
  id            String   @id @default(uuid())
  key           String   @db.VarChar(32)
  seriesCode    Int      @map("series_code")
  valueMicros   Int      @map("value_micros")
  unit          String   @db.VarChar(32)
  period        String   @db.VarChar(32)
  referenceDate DateTime @map("reference_date") @db.Date
  source        String   @default("BCB_SGS") @db.VarChar(20)
  fetchedAt     DateTime @map("fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, referenceDate])
  @@index([key, fetchedAt])
  @@map("economic_indicator_observations")
}

model InvestmentOperation {
  id             String                  @id @default(uuid())
  type           InvestmentOperationType
  quantityUnits  BigInt                  @map("quantity_units")
  unitPriceCents Int                     @map("unit_price_cents")
  feesCents      Int                     @default(0) @map("fees_cents")
  year           Int
  month          Int
  day            Int
  note           String?                 @db.VarChar(500)
  importSource      TransactionImportSource? @map("import_source")
  importFingerprint String?                  @map("import_fingerprint") @db.Char(64)
  sequence          Int?                     @map("sequence")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  fiscalEvent InvestmentFiscalEvent?
  taxWithholdings InvestmentTaxWithholding[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month, day])
  @@index([userId, accountId, year, month, day])
  @@index([userId, assetId, year, month, day])
  @@unique([userId, importFingerprint])
  @@map("investment_operations")
}

model InvestmentFiscalEvent {
  id                   String                              @id @default(uuid())
  type                 InvestmentFiscalEventType
  originalType         InvestmentFiscalEventType          @map("original_type")
  classificationSource InvestmentFiscalClassificationSource @default(SYSTEM) @map("classification_source")
  quantityUnits        BigInt                              @map("quantity_units")
  sequence             Int?                                @map("sequence")
  year                 Int
  month                Int
  day                  Int
  sourceInstitution    String?                            @map("source_institution") @db.VarChar(120)
  destinationInstitution String?                          @map("destination_institution") @db.VarChar(120)
  reclassificationNote String?                            @map("reclassification_note") @db.VarChar(500)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  operationId String?              @unique @map("operation_id")
  operation   InvestmentOperation? @relation(fields: [operationId], references: [id], onDelete: Cascade)

  foreignTaxesPaid InvestmentForeignTaxPaid[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month, day])
  @@index([userId, accountId, year, month, day])
  @@index([userId, assetId, year, month, day])
  @@map("investment_fiscal_events")
}

model InvestmentFiscalCostAdjustment {
  id             String @id @default(uuid())
  quantityUnits  BigInt @map("quantity_units")
  costBasisCents Int    @map("cost_basis_cents")
  year           Int
  month          Int
  day            Int
  reason         String @db.VarChar(500)
  sourceInstitution String? @map("source_institution") @db.VarChar(120)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month, day])
  @@index([userId, assetId, year, month, day])
  @@map("investment_fiscal_cost_adjustments")
}

model InvestmentTaxLossAdjustment {
  id          String @id @default(uuid())
  assetType   InvestmentAssetType @map("asset_type")
  currency    String @db.Char(3)
  amountCents Int    @map("amount_cents")
  year        Int
  month       Int
  reason      String @db.VarChar(500)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month])
  @@index([userId, assetType, currency, year, month])
  @@map("investment_tax_loss_adjustments")
}

model InvestmentTaxWithholding {
  id          String                    @id @default(uuid())
  assetType   InvestmentAssetType       @map("asset_type")
  currency    String                    @db.Char(3)
  amountCents Int                       @map("amount_cents")
  year        Int
  month       Int
  day         Int
  source            InvestmentTaxRecordSource @default(MANUAL)
  note              String?                   @db.VarChar(500)
  importFingerprint String?                   @map("import_fingerprint") @db.Char(64)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId String?
  asset   InvestmentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  operationId String?              @map("operation_id")
  operation   InvestmentOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  brokerageReview InvestmentBrokerageTaxReview?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month])
  @@index([userId, assetType, currency, year, month])
  @@index([userId, assetId, year, month])
  @@index([userId, operationId])
  @@unique([userId, importFingerprint])
  @@map("investment_tax_withholdings")
}

model InvestmentTaxPayment {
  id              String              @id @default(uuid())
  assetType       InvestmentAssetType @map("asset_type")
  currency        String              @db.Char(3)
  amountCents     Int                 @map("amount_cents")
  competenceYear  Int                 @map("competence_year")
  competenceMonth Int                 @map("competence_month")
  code            String              @db.VarChar(10)
  paidYear        Int                 @map("paid_year")
  paidMonth       Int                 @map("paid_month")
  paidDay         Int                 @map("paid_day")
  note            String?             @db.VarChar(500)
  receiptReference String?            @map("receipt_reference") @db.VarChar(120)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String?      @unique @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, competenceYear, competenceMonth])
  @@index([userId, assetType, currency, competenceYear, competenceMonth])
  @@index([userId, paidYear, paidMonth, paidDay])
  @@map("investment_tax_payments")
}

model InvestmentForeignTaxPaid {
  id                     String                     @id @default(uuid())
  countryCode            String                     @map("country_code") @db.Char(2)
  currency               String                     @db.Char(3)
  amountCents            Int                        @map("amount_cents")
  paidYear               Int                        @map("paid_year")
  paidMonth              Int                        @map("paid_month")
  paidDay                Int                        @map("paid_day")
  eligibilityBasis       ForeignTaxEligibilityBasis @map("eligibility_basis")
  nonRefundableConfirmed Boolean                    @map("non_refundable_confirmed")
  note                   String?                    @db.VarChar(500)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  incomeId String?          @map("income_id")
  income   InvestmentIncome? @relation(fields: [incomeId], references: [id], onDelete: Restrict)

  fiscalEventId String?               @map("fiscal_event_id")
  fiscalEvent   InvestmentFiscalEvent? @relation(fields: [fiscalEventId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, paidYear, paidMonth, paidDay])
  @@index([userId, assetId, paidYear])
  @@index([userId, incomeId])
  @@index([userId, fiscalEventId])
  @@map("investment_foreign_taxes_paid")
}

enum InvestmentTaxReviewStatus {
  PENDING
  RESOLVED
}

model InvestmentMutationRequest {
  id                 String @id @default(uuid())
  scope              String @db.VarChar(64)
  idempotencyKeyHash String @map("idempotency_key_hash") @db.Char(64)
  requestHash        String @map("request_hash") @db.Char(64)
  resourceId         String? @map("resource_id") @db.VarChar(64)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, scope, idempotencyKeyHash])
  @@index([userId, scope, createdAt])
  @@map("investment_mutation_requests")
}

model InvestmentBrokerageTaxReview {
  id                 String                    @id @default(uuid())
  importFingerprint  String                    @map("import_fingerprint") @db.Char(64)
  noteNumber         String                    @map("note_number") @db.VarChar(120)
  sourceInstitution  String                    @map("source_institution") @db.VarChar(180)
  sourceReference    String?                   @map("source_reference") @db.VarChar(200)
  amountCents        Int                       @map("amount_cents")
  year               Int
  month              Int
  day                Int
  reason             String                    @db.VarChar(500)
  status             InvestmentTaxReviewStatus @default(PENDING)
  resolvedAt         DateTime?                 @map("resolved_at")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resolvedWithholdingId String?                    @unique @map("resolved_withholding_id")
  resolvedWithholding   InvestmentTaxWithholding?  @relation(fields: [resolvedWithholdingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, importFingerprint])
  @@index([userId, status, year, month])
  @@map("investment_brokerage_tax_reviews")
}

model InvestmentFiscalPendingResolution {
  id            String @id @default(uuid())
  year          Int
  pendingKey    String @map("pending_key") @db.VarChar(200)
  fingerprint   String @db.Char(64)
  justification String @db.VarChar(1000)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, year, fingerprint])
  @@index([userId, year])
  @@index([userId, year, pendingKey])
  @@map("investment_fiscal_pending_resolutions")
}

model AnnualFinancialTaxStatement {
  id                    String @id @default(uuid())
  calendarYear          Int @map("calendar_year")
  sourceInstitution     String @map("source_institution") @db.VarChar(180)
  sourceInstitutionCnpj String? @map("source_institution_cnpj") @db.VarChar(18)
  documentType          String @map("document_type") @db.VarChar(80)
  positions             Json
  incomes               Json
  taxWithholdings       Json @map("tax_withholdings")
  notes                 Json
  warnings              Json
  importFingerprint     String @map("import_fingerprint") @db.Char(64)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, importFingerprint])
  @@index([userId, calendarYear, sourceInstitutionCnpj])
  @@map("annual_financial_tax_statements")
}


model InvestmentIncome {
  id             String               @id @default(uuid())
  type           InvestmentIncomeType @default(INCOME)
  quantityUnits  BigInt               @map("quantity_units")
  unitValueCents Int                  @map("unit_value_cents")
  netAmountCents Int                  @map("net_amount_cents")
  year           Int
  month          Int
  day            Int
  note           String?              @db.VarChar(500)
  importSource      TransactionImportSource? @map("import_source")
  importFingerprint String?                  @map("import_fingerprint") @db.Char(64)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  foreignTaxesPaid InvestmentForeignTaxPaid[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, year, month, day])
  @@index([userId, accountId, year, month, day])
  @@index([userId, assetId, year, month, day])
  @@unique([userId, importFingerprint])
  @@map("investment_incomes")
}

enum PeriodicSummaryFrequency {
  WEEKLY
}

model Category {
  id          String      @id @default(uuid())
  name        String      @db.VarChar(50)
  color       String      @default("#3B82F6") @db.Char(7)
  icon        String      @default("tag") @db.VarChar(30)
  isActive    Boolean     @default(true)
  type        CategoryType @default(EXPENSE)
  description String?     @db.VarChar(200)
  position    Int         @default(0)
  
  importRules TransactionImportRule[]
  transactions Transaction[]
  transactionAllocations TransactionAllocation[]
  transactionTemplates TransactionTemplate[]
  monthlyLimits CategoryMonthlyLimit[]
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  @@unique([name, userId, type])
  @@map("categories")

  @@index([userId])
  @@index([userId, name])
  @@index([userId, position])
  @@index([userId, type, isActive])
}

enum CategoryType {
  INCOME
  EXPENSE
}

model CategoryMonthlyLimit {
  id         String   @id @default(uuid())
  amount     Int
  year       Int
  month      Int
  currency   String   @default("BRL") @db.Char(3)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, year, month, currency])
  @@index([userId, year, month, currency])
  @@index([categoryId, year, month, currency])
  @@map("category_monthly_limits")
}

model TransactionImportRule {
  id                    String                        @id @default(uuid())
  name                  String                        @db.VarChar(100)
  isActive              Boolean                       @default(true)
  priority              Int                           @default(0)
  transactionType       CategoryType
  descriptionOperator   ImportRuleDescriptionOperator
  descriptionPattern    String                        @db.VarChar(255)
  minAmountCents        Int?
  maxAmountCents        Int?
  normalizedDescription String?                       @db.VarChar(255)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive, priority, id])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@map("transaction_import_rules")
}

enum ImportRuleDescriptionOperator {
  EQUALS
  STARTS_WITH
  CONTAINS
}

model Transaction {
  id                   String               @id @default(uuid())
  amount               Int                  @default(0)
  month                Int
  year                 Int
  day                  Int
  type                 TransactionType
  kind                 TransactionKind      @default(NORMAL)
  description          String               @db.VarChar(255)
  status               TransactionStatus
  reconciliationStatus ReconciliationStatus @default(UNCLEARED) @map("reconciliation_status")
  reconciledAt         DateTime?            @map("reconciled_at")

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  merchantId String?   @map("merchant_id")
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  transferId   String?       @map("transfer_id")
