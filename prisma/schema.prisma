generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(100)
  email        String      @unique @db.VarChar(120)
  password     String      @db.VarChar(255)
  lastLogin    DateTime?   @map("last_login")
  isActive     Boolean     @default(true)
  showValues   Boolean     @default(true)
  accounts     Account[]
  categories   Category[]
  investments  Investment[]
  resetTokens  PasswordResetToken[]
  transactions Transaction[]
  financialGoals FinancialGoal[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
  @@index([email])
  @@index([createdAt])
  @@index([isActive]) // Para consultas de usuários ativos
  @@index([lastLogin]) // Para encontrar usuários inativos
  @@index([createdAt, isActive]) // Para analytics
}

model Account {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(100)
  type         AccountType
  balance      Int         @default(0)
  currency     String      @default("BRL") @db.Char(3)
  isActive     Boolean     @default(true) // Novo campo para contas inativas
  color        String?     @db.Char(7) // Cor para UI (#FF0000)
  icon         String?     @db.VarChar(30) // Ícone para UI
  description  String?     @db.VarChar(500) // Descrição opcional

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  transactions Transaction[]
  investments  Investment[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("accounts")
  @@unique([name, userId]) // Evitar nomes duplicados por usuário

  // Índices otimizados
  @@index([userId])
  @@index([userId, type])
  @@index([userId, balance])
  @@index([userId, isActive]) // Para filtrar contas ativas
  @@index([currency, type]) // Para conversões
  @@index([createdAt]) 
  @@index([userId, currency, isActive]) // Para dashboards multi-moeda
  @@index([type, isActive]) // Para estatísticas gerais
}

enum AccountType {
  CREDIT_DEBIT  // Contas de crédito/débito (corrente, poupança, cartão, etc.)
  INVESTMENT    // Apenas contas de investimento
}

model Category {
  id          String      @id @default(uuid())
  name        String      @db.VarChar(50)
  color       String      @default("#3B82F6") @db.Char(7) // Cor padrão
  icon        String      @default("tag") @db.VarChar(30) // Ícone padrão
  isActive    Boolean     @default(true)
  type        CategoryType @default(EXPENSE) // Para separar receitas/despesas
  description String?     @db.VarChar(200) // Descrição opcional
  position    Int         @default(0) // Ordenação personalizada
  
  transactions Transaction[]
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  @@unique([name, userId, type])
  @@map("categories")

  // Índices
  @@index([userId])
  @@index([userId, name])
  @@index([userId, isActive])
  @@index([userId, type]) // Para filtrar por tipo
  @@index([userId, position]) // Para ordenação
  @@index([userId, type, isActive]) // Consultas combinadas
  @@index([createdAt])
}

enum CategoryType {
  INCOME    // Para categorias de receita
  EXPENSE   // Para categorias de despesa
}

model Transaction {
  id            String     @id @default(uuid())
  amount        Int        @default(0)
  month         Int
  year          Int
  day           Int
  type          TransactionType
  description   String     @db.VarChar(255)

  status TransactionStatus

  accountId     String
  account       Account    @relation(fields: [accountId], references: [id])
  
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  
  @@map("transactions")

  // Índices otimizados (removendo transactionDate)
  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([userId, type]) // Removido transactionDate
  @@index([userId, year, month])
  @@index([userId, year])
  @@index([accountId, year, month]) // Novo: substitui accountId + transactionDate
  @@index([userId, categoryId, year, month])
  @@index([userId, categoryId, year, month, day]) // Novo: mais específico
  @@index([userId, year, month, type])
  @@index([userId, type, year, month])
  @@index([userId, year, month, day]) // Para consultas diárias
  @@index([accountId, type, year, month])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING    // Para categorias de receita
  COMPLETED   // Para categorias de despesa
  CANCELLED 
}

model Investment {
  id            String     @id @default(uuid())
  amount        Decimal    @db.Decimal(12, 2)
  unitPrice     Decimal    @map("unit_price") @db.Decimal(12, 4)
  quantity      Int    
  type          InvestmentType
  description   String     @db.VarChar(255)
  investmentDate DateTime  @map("investment_date")
  
  accountId     String
  account       Account    @relation(fields: [accountId], references: [id])
  
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  ticker        String    @db.VarChar(10) // Código do ativo (ex: PETR4, BTC)
  
  @@map("investments")
  @@index([userId])
  @@index([accountId])
  @@index([userId, type, investmentDate])
  @@index([userId, ticker])
  @@index([accountId, investmentDate])
}

enum InvestmentType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  SPLIT
  MERGER
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  expiresAt DateTime @map("expires_at") @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("password_reset_tokens")

  @@index([token]) // Já tem @unique, mas pode ser explícito
  @@index([userId]) // Para invalidar tokens antigos
  @@index([expiresAt]) // Para limpeza de tokens expirados
}

// Adicione ao seu schema.prisma atual

enum GoalType {
  TRAVEL
  EMERGENCY_FUND
  INVESTMENT
  EDUCATION
  HOME
  VEHICLE
  OTHER
}

model FinancialGoal {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(100)
  targetAmount  Int      // Em centavos (250000 = R$ 2.500,00)
  currentAmount Int      @default(0)
  deadline      DateTime
  type          GoalType @default(OTHER)
  color         String   @default("#3B82F6") @db.Char(7)
  icon          String   @default("🎯") @db.VarChar(20)
  isCompleted   Boolean  @default(false)
  description   String?  @db.VarChar(500)
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("financial_goals")
  @@index([userId])
  @@index([userId, type])
  @@index([userId, isCompleted])
  @@index([deadline])
  @@index([userId, deadline])
  @@index([createdAt])
}