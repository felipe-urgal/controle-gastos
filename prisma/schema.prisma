generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(100)
  email        String      @unique @db.VarChar(120)
  password     String      @db.VarChar(255)
  lastLogin    DateTime?   @map("last_login")
  isActive     Boolean     @default(true)
  showValues   Boolean     @default(true)

  accounts     Account[]
  categories   Category[]
  resetTokens  PasswordResetToken[]
  transactions Transaction[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
  @@index([lastLogin])
  @@index([createdAt, isActive])
}

model Account {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(100)
  type         AccountType
  balance      Int         @default(0)
  currency     String      @default("BRL") @db.Char(3)
  isActive     Boolean     @default(true)
  color        String?     @db.Char(7)
  icon         String?     @db.VarChar(30)
  description  String?     @db.VarChar(500)

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  transactions Transaction[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("accounts")
  @@unique([name, userId])
 
  @@index([userId])
  @@index([userId, type])
  @@index([userId, isActive])
  @@index([userId, currency, isActive])
}

enum AccountType {
  CREDIT_DEBIT
  INVESTMENT
}

model Category {
  id          String      @id @default(uuid())
  name        String      @db.VarChar(50)
  color       String      @default("#3B82F6") @db.Char(7)
  icon        String      @default("tag") @db.VarChar(30)
  isActive    Boolean     @default(true)
  type        CategoryType @default(EXPENSE)
  description String?     @db.VarChar(200)
  position    Int         @default(0)
  
  transactions Transaction[]
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  @@unique([name, userId, type])
  @@map("categories")

  @@index([userId])
  @@index([userId, name])
  @@index([userId, position])
  @@index([userId, type, isActive])
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Transaction {
  id            String     @id @default(uuid())
  amount        Int        @default(0)
  month         Int
  year          Int
  day           Int
  type          TransactionType
  description   String     @db.VarChar(255)

  status TransactionStatus

  accountId     String
  account       Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  
  @@map("transactions")

  @@index([userId, year, month])
  @@index([userId, year, month, day])
  @@index([accountId, year, month])
  @@index([userId, categoryId, year, month])
  @@index([accountId, type, year, month])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at") @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("password_reset_tokens")

  @@index([userId])
  @@index([expiresAt])
}
