generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  password   String
  transacoes Transacao[] // Relacionamento com Transacao
  resetTokens PasswordResetToken[]
  categorias  Categoria[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Categoria {
  id          String      @id @default(uuid())
  nome        String      
  transacoes  Transacao[]
  userId      String      // Novo campo para relacionamento
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@unique([nome, userId]) // Garante que o nome seja único por usuário
}

model Transacao {
  id        String   @id @default(uuid())
  valor     Decimal
  valorUnitario Decimal?
  quantidade    Int?     // Quantidade opcional
  mes       Int
  ano       Int
  tipo      String   // "renda", "despesa" ou "investimentos"
  descricao String
  data      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoriaId   String?  // Relacionamento opcional com Categoria
  categoria     Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}
