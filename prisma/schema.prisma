generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(100)
  email               String    @unique @db.VarChar(120)
  emailVerifiedAt     DateTime? @default(now()) @map("email_verified_at")
  password            String    @db.VarChar(255)
  lastLogin           DateTime? @map("last_login")
  isActive            Boolean   @default(true)
  authVersion         Int       @default(0) @map("auth_version")
  showValues          Boolean   @default(true)
  totpEnabled         Boolean   @default(false) @map("totp_enabled")
  totpSecretEncrypted String?   @map("totp_secret_encrypted") @db.Text
  totpActivatedAt     DateTime? @map("totp_activated_at")
  totpLastUsedStep    BigInt?   @map("totp_last_used_step")

  accounts              Account[]
  categories            Category[]
  categoryMonthlyLimits CategoryMonthlyLimit[]
  importRules           TransactionImportRule[]
  mfaLoginChallenges    MfaLoginChallenge[]
  reconciliationEvents  AccountReconciliationEvent[]
  resetTokens           PasswordResetToken[]
  totpRecoveryCodes     TotpRecoveryCode[]
  transactions          Transaction[]
  transactionSeries     TransactionSeries[]
  transfers             Transfer[]
  creditCardPayments     CreditCardPayment[]
  financialGoals         FinancialGoal[]
  financialGoalEntries   FinancialGoalEntry[]
  exchangeRates           ExchangeRate[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
  @@index([lastLogin])
  @@index([createdAt, isActive])
}

model Account {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(100)
  type         AccountType
  currency     String      @default("BRL") @db.Char(3)
  isActive     Boolean     @default(true)
  color        String?     @db.Char(7)
  icon         String?     @db.VarChar(30)
  description          String? @db.VarChar(500)
  creditLimit          Int?    @map("credit_limit")
  statementClosingDay  Int?    @map("statement_closing_day")
  statementDueDay      Int?    @map("statement_due_day")

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  importRules          TransactionImportRule[]
  reconciliationEvents AccountReconciliationEvent[]
  transactions         Transaction[]
  cardPayments         CreditCardPayment[] @relation("CreditCardPaymentCard")
  sourceCardPayments   CreditCardPayment[] @relation("CreditCardPaymentSource")
  financialGoals       FinancialGoal[]
  
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("accounts")
  @@unique([name, userId])
 
  @@index([userId])
  @@index([userId, type])
  @@index([userId, isActive])
  @@index([userId, currency, isActive])
}

enum AccountType {
  CREDIT_DEBIT
  INVESTMENT
  CREDIT_CARD
}

model Category {
  id          String      @id @default(uuid())
  name        String      @db.VarChar(50)
  color       String      @default("#3B82F6") @db.Char(7)
  icon        String      @default("tag") @db.VarChar(30)
  isActive    Boolean     @default(true)
  type        CategoryType @default(EXPENSE)
  description String?     @db.VarChar(200)
  position    Int         @default(0)
  
  importRules TransactionImportRule[]
  transactions Transaction[]
  monthlyLimits CategoryMonthlyLimit[]
  
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  @@unique([name, userId, type])
  @@map("categories")

  @@index([userId])
  @@index([userId, name])
  @@index([userId, position])
  @@index([userId, type, isActive])
}

enum CategoryType {
  INCOME
  EXPENSE
}

model CategoryMonthlyLimit {
  id         String   @id @default(uuid())
  amount     Int
  year       Int
  month      Int
  currency   String   @default("BRL") @db.Char(3)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, year, month, currency])
  @@index([userId, year, month, currency])
  @@index([categoryId, year, month, currency])
  @@map("category_monthly_limits")
}

model TransactionImportRule {
  id                    String                        @id @default(uuid())
  name                  String                        @db.VarChar(100)
  isActive              Boolean                       @default(true)
  priority              Int                           @default(0)
  transactionType       CategoryType
  descriptionOperator   ImportRuleDescriptionOperator
  descriptionPattern    String                        @db.VarChar(255)
  minAmountCents        Int?
  maxAmountCents        Int?
  normalizedDescription String?                       @db.VarChar(255)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive, priority, id])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@map("transaction_import_rules")
}

enum ImportRuleDescriptionOperator {
  EQUALS
  STARTS_WITH
  CONTAINS
}

model Transaction {
  id                   String               @id @default(uuid())
  amount               Int                  @default(0)
  month                Int
  year                 Int
  day                  Int
  type                 TransactionType
  kind                 TransactionKind      @default(NORMAL)
  description          String               @db.VarChar(255)
  status               TransactionStatus
  reconciliationStatus ReconciliationStatus @default(UNCLEARED) @map("reconciliation_status")
  reconciledAt         DateTime?            @map("reconciled_at")

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  transferId   String?       @map("transfer_id")
  transferRole TransferRole? @map("transfer_role")
  transfer     Transfer?     @relation(fields: [transferId, userId], references: [id, userId], onDelete: Cascade)

  creditCardPayment CreditCardPayment?

  seriesId    String?
  series      TransactionSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesIndex Int?               @map("series_index")

  importSource      TransactionImportSource? @map("import_source")
  importFingerprint String?                  @map("import_fingerprint") @db.Char(64)
  importExternalId  String?                  @map("import_external_id") @db.VarChar(191)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("transactions")

  @@index([userId, year, month])
  @@index([userId, year, month, day])
  @@index([accountId, year, month])
  @@index([userId, categoryId, year, month])
  @@index([accountId, type, year, month])
  @@index([userId, status, accountId, type])
  @@index([seriesId])
  @@index([userId, importSource])
  @@index([transferId])
  @@index([userId, kind, year, month])
  @@index([userId, accountId, reconciliationStatus, year, month])
  @@unique([seriesId, seriesIndex])
  @@unique([userId, importFingerprint])
  @@unique([transferId, transferRole])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionKind {
  NORMAL
  TRANSFER
  CARD_PAYMENT
}

enum TransferRole {
  SOURCE
  DESTINATION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReconciliationStatus {
  UNCLEARED
  CLEARED
  RECONCILED
}

model AccountReconciliationEvent {
  id                  String                    @id @default(uuid())
  action              ReconciliationAuditAction
  batchReconciledAt   DateTime                  @map("batch_reconciled_at")
  transactionCount    Int                       @map("transaction_count")
  cutoffYear          Int?                      @map("cutoff_year")
  cutoffMonth         Int?                      @map("cutoff_month")
  cutoffDay           Int?                      @map("cutoff_day")
  statementBalance    Int?                      @map("statement_balance")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([accountId, batchReconciledAt, action])
  @@index([userId, accountId, createdAt])
  @@map("account_reconciliation_events")
}

enum ReconciliationAuditAction {
  CONFIRMED
  UNDONE
}

enum TransactionImportSource {
  CSV
  OFX
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum TransactionSeriesType {
  RECURRING
  INSTALLMENT
}

model TransactionSeries {
  id              String                @id @default(uuid())
  type            TransactionSeriesType @default(RECURRING)
  frequency       RecurrenceFrequency   @default(MONTHLY)
  interval        Int                   @default(1)
  description     String?               @db.VarChar(100)
  anchorDay       Int
  startYear       Int
  startMonth      Int
  startDay        Int
  endYear         Int
  endMonth        Int
  endDay          Int
  occurrenceCount Int

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("transaction_series")
  @@index([userId])
  @@index([userId, type])
}

model Transfer {
  id                 String        @id @default(uuid())
  idempotencyKeyHash String?       @map("idempotency_key_hash") @db.Char(64)
  requestHash        String?       @map("request_hash") @db.Char(64)
  deletedAt          DateTime?     @map("deleted_at")
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, userId])
  @@unique([userId, idempotencyKeyHash])
  @@index([userId])
  @@index([userId, deletedAt])
  @@map("transfers")
}

model CreditCardPayment {
  id                 String @id @default(uuid())
  amount             Int
  closingYear        Int    @map("closing_year")
  closingMonth       Int    @map("closing_month")
  closingDay         Int    @map("closing_day")
  idempotencyKeyHash String @map("idempotency_key_hash") @db.Char(64)
  requestHash        String @map("request_hash") @db.Char(64)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardAccountId String  @map("card_account_id")
  cardAccount   Account @relation("CreditCardPaymentCard", fields: [cardAccountId], references: [id], onDelete: Cascade)

  sourceAccountId String  @map("source_account_id")
  sourceAccount   Account @relation("CreditCardPaymentSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)

  sourceTransactionId String      @unique @map("source_transaction_id")
  sourceTransaction   Transaction @relation(fields: [sourceTransactionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, idempotencyKeyHash])
  @@unique([userId, cardAccountId, closingYear, closingMonth, closingDay])
  @@index([userId, cardAccountId, createdAt])
  @@index([userId, sourceAccountId])
  @@map("credit_card_payments")
}

enum FinancialGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum FinancialGoalEntryType {
  CONTRIBUTION
  WITHDRAWAL
}

model FinancialGoal {
  id          String              @id @default(uuid())
  name        String              @db.VarChar(100)
  targetAmount Int                @map("target_amount")
  currency    String              @default("BRL") @db.Char(3)
  targetYear  Int?                @map("target_year")
  targetMonth Int?                @map("target_month")
  targetDay   Int?                @map("target_day")
  status      FinancialGoalStatus @default(ACTIVE)
  description String?             @db.VarChar(500)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  entries FinancialGoalEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status, createdAt])
  @@index([userId, currency, status])
  @@index([userId, accountId])
  @@map("financial_goals")
}

model FinancialGoalEntry {
  id          String                 @id @default(uuid())
  type        FinancialGoalEntryType
  amount      Int
  description String?                @db.VarChar(255)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalId String @map("goal_id")
  goal   FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, goalId, createdAt])
  @@map("financial_goal_entries")
}

model ExchangeRate {
  id             String @id @default(uuid())
  fromCurrency   String @map("from_currency") @db.Char(3)
  toCurrency     String @map("to_currency") @db.Char(3)
  numerator      Int
  denominator    Int
  source         ExchangeRateSource @default(MANUAL)
  referenceYear  Int @map("reference_year")
  referenceMonth Int @map("reference_month")
  referenceDay   Int @map("reference_day")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, fromCurrency, toCurrency, source, referenceYear, referenceMonth, referenceDay])
  @@index([userId, fromCurrency, toCurrency, referenceYear, referenceMonth, referenceDay])
  @@map("exchange_rates")
}

enum ExchangeRateSource {
  MANUAL
}

model TotpRecoveryCode {
  id       String    @id @default(uuid())
  codeHash String    @map("code_hash") @db.Char(64)
  usedAt   DateTime? @map("used_at")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("totp_recovery_codes")
}

model MfaLoginChallenge {
  id         String    @id @default(uuid())
  jtiHash    String    @unique @map("jti_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("mfa_login_challenges")
}

model PasswordResetToken {
  id    String @id @default(uuid())
  token String @unique @db.Char(64)
  
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at") @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("password_reset_tokens")

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  id           String    @id @default(uuid())
  key          String    @db.Char(64)
  action       String    @db.VarChar(32)
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now()) @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([key, action])
  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("auth_rate_limits")
}
